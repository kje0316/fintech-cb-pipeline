          "format": "table",
          "rawSql": "SELECT\n  CASE\n    WHEN default_probability < 0.1 THEN '0-10%'\n    WHEN default_probability < 0.2 THEN '10-20%'\n    WHEN default_probability < 0.3 THEN '20-30%'\n    WHEN default_probability < 0.4 THEN '30-40%'\n    WHEN default_probability < 0.5 THEN '40-50%'\n    WHEN default_probability < 0.6 THEN '50-60%'\n    WHEN default_probability < 0.7 THEN '60-70%'\n    WHEN default_probability < 0.8 THEN '70-80%'\n    WHEN default_probability < 0.9 THEN '80-90%'\n    ELSE '90-100%'\n  END AS bucket,\n  COUNT(*) AS count\nFROM logs.prediction_logs\nWHERE created_at > NOW() - INTERVAL '24 hours'\nGROUP BY bucket\nORDER BY bucket",
